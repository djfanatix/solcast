  "flow": {
    "conditions": [
      {
        "id": "solcast_forecast_between_times",
        "title": {
          "en": "Forecast between times"
        },
        "titleFormatted": {
          "en": "Forecast between [[startTime]] and [[endTime]] is above [[threshold]]"
        },
        "hint": {
          "en": "Checks if the forecasted PV production between start and end time exceeds the threshold"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solcast"
          },
          {
            "type": "time",
            "name": "startTime",
            "title": {
              "en": "Start Time (HH:mm)"
            },
            "placeholder": {
              "en": "12:00"
            }
          },
          {
            "type": "time",
            "name": "endTime",
            "title": {
              "en": "End Time (HH:mm)"
            },
            "placeholder": {
              "en": "17:00"
            }
          },
          {
            "type": "number",
            "name": "threshold",
            "title": {
              "en": "Threshold (kWh)"
            },
            "min": 0,
            "step": 0.1
          }
        ]
      },
      {
        "id": "forecastsolar_forecast_between_times",
        "title": {
          "en": "Forecast between times"
        },
        "titleFormatted": {
          "en": "Forecast between [[startTime]] and [[endTime]] is above [[threshold]]"
        },
        "hint": {
          "en": "Checks if the forecasted PV production between start and end time exceeds the threshold"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=forecastsolar"
          },
          {
            "type": "time",
            "name": "startTime",
            "title": {
              "en": "Start Time (HH:mm)"
            },
            "placeholder": {
              "en": "12:00"
            }
          },
          {
            "type": "time",
            "name": "endTime",
            "title": {
              "en": "End Time (HH:mm)"
            },
            "placeholder": {
              "en": "17:00"
            }
          },
          {
            "type": "number",
            "name": "threshold",
            "title": {
              "en": "Threshold (kWh)"
            },
            "min": 0,
            "step": 0.1
          }
        ]
      }
    ],
